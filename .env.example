# ============================================================
# CourseShop 环境配置示例
# 复制为 .env 后按实际环境修改。不要把真实密钥提交到版本库。
# Copy this file to `.env` and adjust the values for your environment.
# ============================================================

# 运行环境：local | production
APP_ENV=local

# 调试模式：生产环境必须为 false
APP_DEBUG=true

# 站点根地址（不要以 / 结尾），用于生成支付回调地址
APP_URL=http://127.0.0.1:8088

# 应用密钥：用于签名 Cookie / 一次性令牌，请随机生成 32 位以上字符串
APP_KEY=change-me-to-a-random-32-chars-secret

# 时区
APP_TIMEZONE=Asia/Shanghai

# ---------------- 数据库 ----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courseshop
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# 安装向导完成后会自动写入 .env，此处仅作为默认值

# ---------------- 会话 ----------------
SESSION_NAME=courseshop_session
SESSION_LIFETIME=7200

# ---------------- 上传限制 ----------------
UPLOAD_MAX_VIDEO_MB=2048
UPLOAD_MAX_ATTACHMENT_MB=10

# ---------------- 视频存储 ----------------
# 存储驱动：local（默认）/ oss / cos / s3（对象存储为 P2 预留）
VIDEO_DISK=local
# 本地视频根目录，留空则使用 storage/private/videos
VIDEO_LOCAL_ROOT=
# 播放地址签名有效期（秒），用于防盗链
VIDEO_URL_TTL=7200
# ffmpeg 可执行文件路径，留空则在 PATH 中查找（用于 HLS 转码与首帧截取，可选）
VIDEO_FFMPEG_PATH=
# HLS 单个 ts 分片时长（秒），后台「视频设置」可覆盖
VIDEO_HLS_SEGMENT_SECONDS=10

# ---------------- 缓存 ----------------
# 缓存驱动：file（默认，零依赖文件缓存，跨请求持久化）/ array（进程内数组，仅当次请求有效）
CACHE_DRIVER=file
# 文件缓存目录，留空则使用 storage/cache
CACHE_PATH=
# 默认缓存有效期（秒）
CACHE_TTL=300

# ---------------- 错误监控 ----------------
# 开关（默认关闭）；也可在后台「错误监控」分组中配置（后台优先）
MONITOR_ENABLED=false
# 上报通道：log（默认，写入 storage/logs/monitor-*.log）/ webhook（JSON POST）
MONITOR_CHANNEL=log
# webhook 通道的上报地址（channel=webhook 时必填）
MONITOR_WEBHOOK=
# 上报超时（秒）
MONITOR_TIMEOUT=3
